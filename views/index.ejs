<!DOCTYPE html>
<html><head><title>Inventory · Categories</title><link rel="stylesheet" href="/style.css"></head><body>
<header class="topbar"><div class="app-shell topbar-inner"><a class="brand" href="/"><span class="brand-mark">▦</span><span class="brand-name">Inventory</span></a><a class="topbar-link" href="/categories/new">New category</a></div></header>
<main class="app-shell"><div class="page-heading"><p class="eyebrow">Workspace</p><h1>Categories</h1><p class="subtitle">Keep your stock organized by category.</p></div>
<div class="toolbar"><span class="muted"><%= categories.length %> categor<%= categories.length === 1 ? 'y' : 'ies' %></span><a class="button" href="/categories/new">+ Add category</a></div>
<section class="card category-list"><% if (categories.length === 0) { %><div class="empty-state"><strong>No categories yet</strong><p>Add your first category to get started.</p><a class="button" href="/categories/new">Add category</a></div><% } %>
<% categories.forEach(function(cat) { %><div class="category-row"><a class="category-name" href="/categories/<%= cat.id %>/items"><%= cat.name %></a><div class="row-actions"><a href="/categories/<%= cat.id %>/edit">Edit</a><form class="inline-form" action="/categories/<%= cat.id %>/delete" method="POST"><button class="button-danger" type="submit">Delete</button></form></div></div><% }) %></section></main>
</body></html>
